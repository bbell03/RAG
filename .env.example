# Copy to .env and paste the keys. .env is gitignored.
# Gemini: https://aistudio.google.com/apikey  (Create API key)
# Voyage:  https://dash.voyageai.com           (Create new secret key)
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Optional. gemini-3.5-flash is recommended for stability on the free tier. Default in code is gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.5-flash

# Optional local chat model. Used when Gemini or Claude is out of quota or unreachable.
# The same prompt is sent. This does not replace Voyage embeddings.
# Ollama: ollama serve && ollama pull llama3.1
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# LM Studio: LOCAL_LLM_URL=http://127.0.0.1:1234/v1 and the model name shown in the app.
# LOCAL_LLM_TIMEOUT=180
