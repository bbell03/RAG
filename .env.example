# Copy to .env (gitignored). Shell env wins over this file.

# Required for build / query / recommend embeddings:
# https://dash.voyageai.com
VOYAGE_API_KEY=

# Chat — use local, Gemini, or Claude (at least one path for validate / research / ingest drafts)
# Local (Ollama): open -a Ollama   then:
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_TIMEOUT=180
# LOCAL_LLM_API_KEY=

# Optional cloud (used first when set; falls back to local on quota/outage if LOCAL_LLM_* is set)
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Optional Anthropic
# ANTHROPIC_API_KEY=
